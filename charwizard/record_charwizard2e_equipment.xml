<?xml version="1.0" encoding="iso-8859-1"?>
<root>
	<windowclass name="charwizard2e_sub_equipment">
		<margins control="0,0,0,7" />
		<script file="charwizard/scripts/page_equipment.lua" />
		<sheetdata>
			<anchor_content_top />
			<anchor_content_bottom />

			<!-- Faded full-frame wallpaper (drawn first / behind everything; disabled). -->
			<genericcontrol name="equipment_art">
				<anchored>
					<top parent="contentanchor" anchor="top" relation="relative" offset="0" />
					<bottom parent="bottomanchor" anchor="bottom" relation="relative" offset="0" />
					<left parent="contentanchor" anchor="left" relation="relative" offset="0" />
					<right parent="contentanchor" anchor="right" relation="relative" offset="0" />
				</anchored>
				<disabled />
			</genericcontrol>

			<header_content_framed_metalplate name="equipment_header">
				<static textres="charwizard2e_title_equipment" />
			</header_content_framed_metalplate>

			<label name="label_needalignment">
				<anchored to="contentanchor">
					<top anchor="bottom" relation="relative" offset="18" />
					<left anchor="left" relation="relative" offset="6" />
					<right offset="-14" />
				</anchored>
				<static textres="charwizard2e_msg_needalignment_for_equipment" />
				<multilinespacing>16</multilinespacing>
			</label>

			<label name="wealth_formula_label">
				<anchored to="contentanchor">
					<top anchor="bottom" relation="relative" offset="18" />
					<left anchor="left" relation="relative" offset="6" />
				</anchored>
				<font>sheetlabel</font>
				<static textres="charwizard2e_label_wealth_formula" />
			</label>
			<simplestringc name="wealth_formula">
				<anchored to="wealth_formula_label">
					<top anchor="bottom" relation="relative" offset="6" />
					<left />
					<right offset="-14" />
				</anchored>
				<font>sheettext</font>
				<multilinespacing>16</multilinespacing>
				<readonly />
				<nodrag />
			</simplestringc>

			<buttoncontrol name="wealth_roll_button">
				<anchored width="36" height="36">
					<top parent="wealth_formula" anchor="bottom" relation="relative" offset="14" />
					<left parent="contentanchor" anchor="left" relation="relative" offset="6" />
				</anchored>
				<icon normal="charwizard2e_dice" />
				<tooltip textres="charwizard2e_wealth_roll_tooltip" />
				<script>
					function onButtonPress()
						CharWizard2E.rollStartingWealth(window);
					end
				</script>
			</buttoncontrol>

			<label name="wealth_result_label">
				<anchored to="wealth_roll_button" position="righthigh" offset="14,6" width="160" height="20" />
				<font>sheetlabel</font>
				<static textres="charwizard2e_label_wealth_result" />
			</label>
			<label name="wealth_result">
				<anchored to="wealth_result_label" width="280" height="24">
					<top anchor="bottom" relation="relative" offset="4" />
					<left anchor="left" relation="relative" offset="0" />
				</anchored>
				<font>sheettext</font>
			</label>

			<button_text name="wealth_clear_button">
				<anchored to="wealth_roll_button" width="80" height="20">
					<top anchor="bottom" relation="relative" offset="48" />
					<left anchor="left" relation="relative" offset="0" />
				</anchored>
				<state textres="charwizard2e_button_clear_roll" />
				<script>
					function onButtonPress()
						window.clearWealthRoll();
					end
				</script>
			</button_text>

			<!-- Reminder line for the buy section. -->
			<simplestringc name="items_hint">
				<anchored to="wealth_clear_button">
					<top anchor="bottom" relation="relative" offset="18" />
					<left parent="contentanchor" anchor="left" relation="relative" offset="6" />
					<right parent="contentanchor" anchor="right" relation="relative" offset="-14" />
				</anchored>
				<font>sheetlabel</font>
				<multilinespacing>14</multilinespacing>
				<readonly />
				<nodrag />
				<static>Buy gear below - your rolled gold drops as you add it. For anything more, open the FG "Items" list in the sidebar and drag it onto your sheet.</static>
			</simplestringc>

			<!-- Curated starter gear: pick items; their cost is deducted from rolled gold. -->
			<header_content_framed_metalplate name="items_header">
				<anchored>
					<top parent="items_hint" anchor="bottom" relation="relative" offset="12" />
					<left />
					<right />
				</anchored>
				<static textres="charwizard2e_items_catalog_title" />
			</header_content_framed_metalplate>
			<button_text name="button_clear_items">
				<anchored to="items_header" position="insidetopright" offset="22,0" width="90" height="18" />
				<state textres="charwizard2e_button_clear_items" />
				<script>
					function onButtonPress()
						CharWizard2E.clearChosenItems();
					end
				</script>
			</button_text>

			<!-- Search the shop by name. -->
			<label name="items_search_label">
				<anchored to="items_header">
					<top anchor="bottom" offset="8" />
					<left parent="contentanchor" anchor="left" offset="8" />
				</anchored>
				<static>Search</static>
			</label>
			<basicstring name="items_search">
				<anchored to="items_search_label" position="righthigh" offset="10,0" width="320" height="20" />
				<script>
					function onValueChanged()
						window.item_list.applyFilter();
					end
				</script>
			</basicstring>
			<!-- Show one type of gear (Armor, Weapons, Ammunition, Gear) or All. -->
			<comboboxc name="items_type">
				<anchored to="items_search" position="righthigh" offset="14,0" width="170" height="20" />
				<frame>
					<name>fieldlight</name>
					<offset>10,5,10,5</offset>
				</frame>
				<font>sheetlabel</font>
				<listdirection>down</listdirection>
				<listmaxsize>5</listmaxsize>
				<tooltip><text>Show one type of gear</text></tooltip>
				<script>
					-- A new type starts a new search: a word left in the box
					-- ("sling") would otherwise hide the whole new list.
					function onValueChanged()
						if (window.items_search.getValue() or "") ~= "" then
							window.items_search.setValue("");
						end
						window.item_list.applyFilter();
					end
				</script>
			</comboboxc>

			<list_content_base name="item_list">
				<anchored height="460">
					<top parent="items_search" anchor="bottom" relation="relative" offset="8" />
					<left parent="contentanchor" anchor="left" relation="relative" offset="4" />
					<right parent="contentanchor" anchor="right" relation="relative" offset="-20" />
				</anchored>
				<class>list_entry_charwiz2e_itemselection</class>
				<sortby><control>sortkey</control></sortby>
				<empty textres="charwizard2e_items_empty" />
				<script>
					function onFilter(w)
						return window.isRowShown(w);
					end
				</script>
			</list_content_base>
			<scrollbar_content_base>
				<anchored to="item_list" />
				<target>item_list</target>
			</scrollbar_content_base>
		</sheetdata>
	</windowclass>

	<!-- One catalog row: [+] add, [-] remove, qty, shield (open item), name, cost -->
	<windowclass name="list_entry_charwiz2e_itemselection">
		<margins control="0,0,10,10" />
		<frame>rowshade</frame>
		<sheetdata>
			<anchor_listitem_left name="leftanchor">
				<anchored offset="10,8" />
			</anchor_listitem_left>
			<anchor_listitem_right name="rightanchor">
				<anchored offset="10,8" />
			</anchor_listitem_right>

			<button_charwiz2e_iadd name="button_select">
				<script>
					function onButtonPress()
						window.onAdd();
					end
				</script>
			</button_charwiz2e_iadd>

			<button_charwiz2e_iremove name="button_remove">
				<script>
					function onButtonPress()
						window.onRemove();
					end
				</script>
			</button_charwiz2e_iremove>

			<label name="qty">
				<anchored to="leftanchor" width="34" height="20">
					<top />
					<left parent="button_remove" anchor="right" relation="relative" offset="6" />
				</anchored>
				<font>sheetlabel</font>
				<center />
			</label>

			<link_listitem_left name="shortcut">
				<anchored to="leftanchor">
					<top />
					<left parent="qty" anchor="right" relation="relative" offset="6" />
				</anchored>
			</link_listitem_left>

			<label name="cost">
				<anchored to="rightanchor" width="120" height="20">
					<top />
					<right relation="relative" offset="-10" postoffset="-10" />
				</anchored>
				<font>sheetlabel</font>
			</label>
			<label name="category">
				<anchored to="rightanchor" width="100" height="20">
					<top />
					<right relation="relative" offset="-6" postoffset="-6" />
				</anchored>
				<font>sheetlabel</font>
			</label>
			<hsc name="sortkey" />

			<string_listitem_center_noframe_static_linked name="name">
				<anchored height="20">
					<top parent="leftanchor" anchor="top" />
					<left parent="shortcut" anchor="right" relation="relative" offset="8" />
					<right parent="cost" anchor="left" relation="relative" offset="-8" />
				</anchored>
				<linktarget>shortcut</linktarget>
			</string_listitem_center_noframe_static_linked>
		</sheetdata>
		<script>
			function onAdd()
				local _, sPath = shortcut.getValue();
				if cost.getValue() == "free" then CharWizard2E.addFreeItem(sPath, name.getValue()); else CharWizard2E.addChosenItem(sPath, name.getValue(), cost.getValue()); end
				updateQty();
			end
			function onRemove()
				local _, sPath = shortcut.getValue();
				CharWizard2E.removeChosenItem(sPath);
				updateQty();
			end
			function updateQty()
				local _, sPath = shortcut.getValue();
				local nQty = CharWizard2E.getChosenQty(sPath);
				qty.setValue((nQty > 0) and ("x" .. nQty) or "");
			end
		</script>
	</windowclass>
</root>
